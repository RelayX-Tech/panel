POSTGRES_PORT=55432
REDIS_PORT=56379
POSTGRES_USER=relayx
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=relayx

# Panel API（生产环境经环境变量注入，不提交真实凭据）
